# Your Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional: Claude model to use (defaults to claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Trigger word for group chats (default: "ai")
# Students type "ai what is anemia?" and the bot replies
# BOT_TRIGGER=ai

# Optional: Custom system prompt for your subject
# SYSTEM_PROMPT=You are a hematology teaching assistant for medical students.
